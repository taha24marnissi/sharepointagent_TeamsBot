# SharePoint AI Assistant Teams Bot - Microsoft 365 Agents Toolkit
# Copy this to .env and fill in your values

# Backend API Configuration (Your FastAPI server)
API_URL=http://localhost:8000

# Teams Bot Configuration (auto-populated by Teams Toolkit)
BOT_ID=
BOT_PASSWORD=
TEAMS_APP_ID=

# Azure Configuration (auto-populated by Teams Toolkit)
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP_NAME=

# Debug Configuration
DEBUG=false

# Logging Configuration
LOG_LEVEL=info