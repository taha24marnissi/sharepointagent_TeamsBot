{
    "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.21/MicrosoftTeams.schema.json",
    "manifestVersion": "1.21",
    "version": "1.0.1",
    "id": "${{TEAMS_APP_ID}}",
    "developer": {
        "name": "My App, Inc.",
        "websiteUrl": "https://www.example.com",
        "privacyUrl": "https://www.example.com/privacy",
        "termsOfUseUrl": "https://www.example.com/termofuse"
    },
    "icons": {
        "color": "color.png",
        "outline": "outline.png"
    },
    "name": {
        "short": "teams_bot_sharepoint${{APP_NAME_SUFFIX}}_taha",
        "full": "full name for teams_bot_sharepoint_taha"
    },
    "description": {
        "short": "short description for teams_bot_sharepoint_taha",
        "full": "full description for teams_bot_sharepoint_taha"
    },
    "accentColor": "#e62e2e",
    "bots": [
        {
            "botId": "${{BOT_ID}}",
            "scopes": [
                "personal",
                "team",
                "groupChat"
            ],
            "supportsFiles": true,
            "isNotificationOnly": false,
            "commandLists": [
                {
                  "scopes": ["personal", "team", "groupChat"],
                  "commands": [
                      {
                          "title": "Hello",
                          "description": "Start a conversation with the AI assistant"
                      },
                      {
                          "title": "/reset",
                          "description": "Clear conversation history and start fresh"
                      },
                      {
                          "title": "List my SharePoint sites",
                          "description": "Get information about your SharePoint sites"
                      },
                      {
                          "title": "What can you do?",
                          "description": "Learn about my capabilities"
                      },
                      {
                          "title": "Help me with SharePoint",
                          "description": "Get assistance with SharePoint operations"
                      }
                  ]
                }
            ]
        }
    ],
    "composeExtensions": [],
    "configurableTabs": [],
    "staticTabs": [],
    "permissions": [
        "identity",
        "messageTeamMembers"
    ],
    "validDomains": []
}